<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/storageStatusLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/local_storage_default_status"
            android:textAppearance="?attr/textAppearanceHeadline6" />

        <LinearLayout
            android:id="@+id/localStorageSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/local_storage_title"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/local_storage_body" />

            <TextView
                android:id="@+id/accountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/not_signed_in"
                android:textAppearance="?attr/textAppearanceBody1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_data_directory"
                android:textAppearance="?attr/textAppearanceBody1" />

            <TextView
                android:id="@+id/dataDirectoryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/local_storage_data_directory_placeholder" />

            <Button
                android:id="@+id/browseDataDirectoryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/button_browse_folder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/purple_200" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_profile_name"
                android:textAppearance="?attr/textAppearanceBody1" />

            <EditText
                android:id="@+id/profileNameField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_profile_name"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_profile_type"
                android:textAppearance="?attr/textAppearanceBody1" />

            <EditText
                android:id="@+id/profileTypeField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_profile_type"
                android:inputType="text"
                android:maxLines="1" />

            <Button
                android:id="@+id/addProfileButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/button_add_profile" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/local_profiles_note" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/purple_200" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_profiles"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <ListView
                android:id="@+id/profileListView"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/googleDriveSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/google_drive_title"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/google_drive_setup_steps" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_google_client_id"
                android:textAppearance="?attr/textAppearanceBody1" />

            <EditText
                android:id="@+id/googleClientIdField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_google_client_id"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_google_passphrase"
                android:textAppearance="?attr/textAppearanceBody1" />

            <EditText
                android:id="@+id/googlePassphraseField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_oauth_passphrase"
                android:inputType="textPassword"
                android:maxLines="1" />

            <TextView
                android:id="@+id/googleSetupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/google_drive_setup_default_status" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveGoogleSetupButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_save_google_setup" />

                <Button
                    android:id="@+id/clearGoogleSetupButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/button_clear_google_setup" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/microsoftDriveSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/microsoft_drive_title"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/microsoft_drive_setup_steps" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_microsoft_client_id"
                android:textAppearance="?attr/textAppearanceBody1" />

            <EditText
                android:id="@+id/microsoftClientIdField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_microsoft_client_id"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_microsoft_passphrase"
                android:textAppearance="?attr/textAppearanceBody1" />

            <EditText
                android:id="@+id/microsoftPassphraseField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_oauth_passphrase"
                android:inputType="textPassword"
                android:maxLines="1" />

            <TextView
                android:id="@+id/microsoftSetupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/microsoft_drive_setup_default_status" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveMicrosoftSetupButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_save_microsoft_setup" />

                <Button
                    android:id="@+id/clearMicrosoftSetupButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/button_clear_microsoft_setup" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
